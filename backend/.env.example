# Server
PORT=4000
CLIENT_URL=http://localhost:5173

# Supabase (Settings > API in your Supabase project)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Stripe (Developers > API keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_CREATOR=
STRIPE_PRICE_ID_PRO=

# Video/AI processing providers — plug in real services here.
# Until these are set, the backend runs the mock pipeline in src/services/.
TRANSCRIPTION_API_KEY=
VIDEO_PROCESSING_API_KEY=

# Storage for uploaded source videos (e.g. Supabase Storage bucket name)
VIDEO_STORAGE_BUCKET=clippio-uploads
